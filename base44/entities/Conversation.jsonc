{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_avatars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key": {
      "type": "string"
    },
    "last_message_text": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sender_id": {
      "type": "string"
    },
    "unread_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "participant_ids",
    "key"
  ]
}
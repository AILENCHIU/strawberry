{
  "name": "Post",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "song",
        "photo",
        "voice"
      ]
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "nsfw": {
      "type": "boolean",
      "default": false
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "author_name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type"
  ]
}